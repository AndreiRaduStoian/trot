# Conservative research and paper-trading defaults. No credentials or live mode.
TROT_SYMBOL=BTC/EUR
TROT_TIMEFRAME=1d
TROT_MODE=paper
TROT_EXCHANGE_ID=kraken

TROT_INITIAL_CASH_EUR=500
TROT_MAX_BTC_ALLOCATION=0.50
TROT_SMA_DAYS=30
TROT_MOMENTUM_DAYS=14
TROT_VOLATILITY_DAYS=20
TROT_VOLATILITY_TARGET=0.12
TROT_REBALANCE_THRESHOLD=0.05
TROT_MIN_TRADE_EUR=25

# Conservative illustrative costs; verify the venue's current schedule and conditions.
TROT_MAKER_FEE=0.005
TROT_TAKER_FEE=0.005
TROT_SPREAD=0.001
TROT_SLIPPAGE=0.001
TROT_MIN_EXCHANGE_NOTIONAL_EUR=0
TROT_MAX_PAPER_QUOTE_AGE_SECONDS=60

TROT_DATA_DIR=data/market
TROT_DATABASE_PATH=data/bot.db
